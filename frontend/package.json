{
	"name": "todos",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build-integration": "vite build --mode integration",
		"preview": "vite preview --port 5174",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"generate-client": "openapi-ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/js-cookie": "^3.0.6",
		"@vitest/ui": "^5.0.4",
		"autoprefixer": "^10.6.1",
		"daisyui": "^4.12.14",
		"dotenv": "^18.0.8",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.30",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-fa": "^4.0.4",
		"tailwindcss": "^3.4.14",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"type": "module",
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"jose": "^6.2.12",
		"js-cookie": "^3.0.8",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
	"imports": {
		"#api-client": {
			"browser": "./src/lib/client-wrapper/api-client.browser.ts",
			"default": "./src/lib/client-wrapper/api-client.server.ts"
		},
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
